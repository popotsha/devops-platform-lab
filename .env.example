# ──────────────────────────────────────────────────────────────────────────────
# Microservice Starter Kit — Community Edition (root env)
#   cp .env.example .env
# Then replace CHANGE_ME passwords below before: docker compose up --build -d
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL (also used by Keycloak + Nest services via Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=keycloak

# Keycloak admin console (http://localhost:8080)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# NextAuth / Auth.js secret (override in production)
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Observability — master switch for all services + frontends (off by default)
OTEL_ENABLED=false

# Order confirmation emails (notification-service) — off by default
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Microservice Storefront <orders@localhost>

# Optional Keycloak SMTP (forgot-password emails) — uses SMTP_* above when set
# KEYCLOAK_SMTP_FROM=noreply@localhost
# KEYCLOAK_SMTP_FROM_DISPLAY=Storefront
# SMTP_STARTTLS=false

# Optional Stripe (also configurable in nextjs-app/.env.local)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
