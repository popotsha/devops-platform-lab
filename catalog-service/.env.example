# ──────────────────────────────────────────────────────────────────────────────
# catalog-service — local overrides + Grafana credentials hub
#   cp catalog-service/.env.example catalog-service/.env
# Compose injects DB/Keycloak from root .env + service block; this file is also
# env_file for Nest services (Grafana Cloud credentials for optional OTEL).
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=catalog_db

REDIS_HOST=localhost
REDIS_PORT=6379
ORDER_SERVICE_URL=http://localhost:4001

KEYCLOAK_ISSUER=http://localhost:8080/realms/ms-realm
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/ms-realm/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=nextjs-app

# OpenTelemetry — master on/off is OTEL_ENABLED in ROOT .env.
# Fill Grafana credentials here for Compose env_file when telemetry is enabled.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=catalog-service
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=microservice-kit

# Instance ID: numeric ID on Grafana Cloud → OpenTelemetry → Configure (NOT the glc_ token)
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=

# Alternative — pre-encoded header (must be base64(instanceId:token))
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic PASTE_BASE64_HERE
