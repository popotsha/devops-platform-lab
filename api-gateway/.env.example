# ──────────────────────────────────────────────────────────────────────────────
# api-gateway — local overrides (optional; Compose uses service block + env_file)
#   cp api-gateway/.env.example api-gateway/.env
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
API_GATEWAY_PORT=3001
LOG_LEVEL=info

CATALOG_SERVICE_URL=http://localhost:4000
ORDER_SERVICE_URL=http://localhost:4001
NOTIFICATION_SERVICE_URL=http://localhost:4002

KEYCLOAK_ISSUER=http://localhost:8080/realms/ms-realm
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/ms-realm/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=nextjs-app

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://127.0.0.1:4200

REDIS_HOST=localhost
REDIS_PORT=6379
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# OpenTelemetry (master switch: OTEL_ENABLED in root .env)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=microservice-kit
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
