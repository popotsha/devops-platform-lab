# ──────────────────────────────────────────────────────────────────────────────
# Next.js Storefront — local environment
#   cp nextjs-app/.env.local.example nextjs-app/.env.local
#
# Pre-aligned with the bundled Keycloak realm (keycloak/init-realm.json).
# Stripe keys may also be set in root .env (Compose injects them).
# ──────────────────────────────────────────────────────────────────────────────

# Auth.js / NextAuth
AUTH_SECRET=abc123def456ghi789xyz
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Optional: internal issuer when Next runs in-cluster (K8s)
# AUTH_KEYCLOAK_ISSUER_INTERNAL=http://keycloak:8080/realms/ms-realm
# NEXTAUTH_URL_INTERNAL=http://nextjs-app:3000

AUTH_KEYCLOAK_ID=nextjs-app
AUTH_KEYCLOAK_SECRET=4f4c3e7f84c5483b9c3d45a56d7f98a2
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/ms-realm

# API gateway (compose in-cluster: http://api-gateway:3001)
API_GATEWAY_URL=http://localhost:3001

# Admin console (Angular)
NEXT_PUBLIC_ADMIN_CONSOLE_URL=http://localhost:4200

# Runtime (Docker / K8s)
# NODE_ENV=production
# PORT=3000
# HOST=0.0.0.0
# HOSTNAME=0.0.0.0
# NODE_MAX_HTTP_HEADER_SIZE=262144
# LOG_LEVEL=info

# ── Public landing (/) ──
# LANDING_BRAND_NAME=Starter Kit
# LANDING_BRAND_MARK=M
# LANDING_TAGLINE=Microservice Starter Kit
# LANDING_HEADLINE=Learn, demo, and ship a full stack with gateway, SSO, and checkout
# LANDING_PRIMARY_CTA_LABEL=Sign in
# LANDING_PRIMARY_CTA_HREF=/products
# LANDING_SECONDARY_CTA_LABEL=Sign in
# LANDING_COMPANY=Microservice Starter Kit

# ── Stripe checkout ───────────────────────────────────────────────────────────
# Off until STRIPE_ENABLED=true AND keys are set.
# Test keys: https://dashboard.stripe.com/test/apikeys
# Prefer both publishable forms so Docker runtime and `next dev` both work:
#   STRIPE_PUBLISHABLE_KEY            — read at container runtime (recommended)
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY — also supported (same pk_test_… value)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenTelemetry (master switch: OTEL_ENABLED in root .env)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nextjs-app
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=microservice-kit
# GRAFANA_CLOUD_INSTANCE_ID=
# GRAFANA_CLOUD_API_TOKEN=
