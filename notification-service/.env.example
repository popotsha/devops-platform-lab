# ──────────────────────────────────────────────────────────────────────────────
# notification-service — local overrides
#   cp notification-service/.env.example notification-service/.env
# SMTP can also live in root .env (Compose passes it through).
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4002
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=notification_db

REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

KEYCLOAK_ISSUER=http://localhost:8080/realms/ms-realm
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/ms-realm/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=nextjs-app

# Storefront link used in order confirmation emails
STOREFRONT_URL=http://localhost:3000

# ── SMTP email delivery ───────────────────────────────────────────────────────
# Off by default. When disabled or credentials are missing, the service still
# records each order email with status "skipped".
SMTP_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM=Microservice Kit <noreply@localhost>

# OpenTelemetry (master switch: OTEL_ENABLED in root .env)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=notification-service
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=microservice-kit
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
